# Cadence — Environment Configuration Template
# Copy this file to .env for local development:
#   cp .env.example .env

# 1. Database (Required in production)
# Local single-node SQLite (WAL mode enabled automatically):
DATABASE_URL="file:./dev.db"
# For multi-instance cloud deployments, copy prisma/schema.postgresql.prisma to prisma/schema.prisma and set:
# DATABASE_URL="postgresql://user:password@hostname:5432/cadence?schema=public"

# 2. Canonical Application URL
NEXT_PUBLIC_APP_URL="https://cadence.ai"

# 3. Reverse Proxy & Client Identification
# Set TRUST_PROXY="true" ONLY when running behind a reverse proxy (Cloudflare, Vercel, ALB, Caddy, Nginx)
# that strips or overwrites client-supplied forwarding headers.
TRUST_PROXY="false"
# Number of trusted proxy hops from the right of X-Forwarded-For when TRUST_PROXY="true":
TRUSTED_PROXY_HOPS="1"
# Optional explicit single-IP header name set by your ingress (e.g. cf-connecting-ip):
# TRUSTED_IP_HEADER="cf-connecting-ip"

# 4. Distributed Sliding-Window Rate Limiting (Upstash Redis REST)
# Required in production unless ALLOW_IN_MEMORY_RATE_LIMIT="true" is explicitly set for a single-node deployment.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
ALLOW_IN_MEMORY_RATE_LIMIT="true"

# 5. Structured Logging
LOG_LEVEL="info"
