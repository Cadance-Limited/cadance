# ==============================================================================
# Cadence Environment Configuration (.env.example)
# Copy to .env for local development: cp .env.example .env
# Never commit real credentials or production secrets to version control.
# ==============================================================================

# 1. Database Persistence (Required)
# Local development uses SQLite (file:./dev.db).
# Multi-instance production deployments should use managed PostgreSQL (and update prisma/schema.prisma datasource provider).
DATABASE_URL="file:./dev.db"

# 2. Public Application URL (Used for canonical metadata, OpenGraph & sitemap.xml)
NEXT_PUBLIC_APP_URL="https://cadence.ai"

# 3. Reverse Proxy & Client IP Resolution
# Set TRUST_PROXY="true" ONLY when running behind a trusted reverse proxy (e.g., Cloudflare, Vercel, Caddy, ALB)
# that overwrites X-Forwarded-For / X-Real-IP headers.
TRUST_PROXY="false"

# 4. Distributed Rate Limiting (Recommended for multi-instance production)
# When configured, /api/chat, /api/analyze, and /api/subscribe enforce atomic sliding-window limits via Upstash Redis REST API.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Allow in-memory sliding-window rate limiting on single-instance deployments when Redis is not configured:
ALLOW_IN_MEMORY_RATE_LIMIT="true"

# 5. Server Logging Level (debug | info | warn | error)
LOG_LEVEL="info"
