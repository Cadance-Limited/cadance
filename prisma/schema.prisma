// Cadence Prisma Schema
// Supports SQLite for local development/single-node deployments and PostgreSQL for multi-instance production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Waitlist {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  source    String   @default("hero")
  company   String?
  role      String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
